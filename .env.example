# Copy to .env. No secrets. Session lives in .chrome-profile/.

BLUESURF_ORIGIN=https://surf.bluepeople.com
BLUESURF_PROJECT=RLD
OBSIDIAN_VAULT=/path/to/your/BluePeople/vault
OBSIDIAN_TICKETS_DIR=RLand/Tickets
OBSIDIAN_SPRINTS_DIR=RLand/Sprints

# Optional. Directory of the repos to verify and sync.
# Default: a sibling named rland-new, RLand, or rland that contains rland-ui or rland-infra.
# Another project: set this, or put an empty .bluesurf-workspace file in that directory
# (sibling of bluesurf-tools, or its parent). The directory does not need rland-ui.
# RLAND_ROOT=/path/to/rland-new

# How repos run for /bluesurf-verify. Leave unset to ask.
# stack: one repo starts the others (RLAND_RUNNER, discovered from compose).
# individual: each repo runs its own command (make run, make dev, or pnpm dev).
# RLAND_RUN_MODE=stack
# RLAND_RUNNER=rland-infra

# Repos updated before a new branch. When set, sync does not scan the workspace.
# RLAND_BASE=dev
# RLAND_REPOS=rland-auth,rland-collab,rland-commons,rland-core,rland-infra,rland-mcp,rland-ngam,rland-ui

# Optional verify catalog. When set, entries replace the built-in check for that repo and add the rest.
# Quote the value. Format: repo|command|service,service separated by ";".
# Omit services when the repo is not a host service. RLAND_PROBES replaces the built-in probe list.
# RLAND_CHECKS="billing-api|npm test|api;billing-web|pnpm test:e2e|web"
# RLAND_PROBES="api|http://127.0.0.1:9090/health|required;web|http://127.0.0.1:3000/health|optional"
